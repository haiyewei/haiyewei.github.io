{
  "name": "blog-haiyewei-com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "new-post": "tsx scripts/new-post.ts",
    "check": "astro check",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,json,yaml,yml,md,mdx,css,svg}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,astro,json,yaml,yml,md,mdx,css,svg}\"",
    "validate": "pnpm run check && pnpm run format:check && pnpm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/material-symbols": "^1.2.88",
    "@iconify-json/mdi": "^1.2.3",
    "@material/material-color-utilities": "^0.4.0",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "js-yaml": "^5.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
