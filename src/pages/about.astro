---
/**
 * 关于页面
 * 从 Content Collection 读取 Markdown 内容
 */
import { getEntry } from 'astro:content'
import PageLayout from '../layouts/PageLayout.astro'

const page = await getEntry('pages', 'about')

if (!page) {
  return Astro.redirect('/404')
}

const { Content } = await page.render()
---

<PageLayout title={page.data.title} description={page.data.description} containerSize="md">
  <article class="page-content">
    <Content />
  </article>
</PageLayout>

<style>
  .page-content {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .page-content :global(h2) {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin: var(--space-10) 0 var(--space-4) 0;
    font-weight: var(--font-semibold);
  }

  .page-content :global(h2:first-child) {
    margin-top: 0;
  }

  .page-content :global(p) {
    margin-bottom: var(--space-4);
  }

  .page-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .page-content :global(a) {
    color: var(--link-color);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .page-content :global(a:hover) {
    color: var(--link-hover);
    text-decoration: underline;
  }

  .page-content :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
  }

  .page-content :global(li) {
    color: var(--text-secondary);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-light);
  }

  .page-content :global(li:last-child) {
    border-bottom: none;
  }

  .page-content :global(strong) {
    color: var(--text-primary);
    font-weight: var(--font-semibold);
  }

  @media (max-width: 640px) {
    .page-content :global(h2) {
      font-size: var(--text-xl);
    }
  }
</style>
