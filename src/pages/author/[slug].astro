---
/**
 * 作者详情页
 * 显示作者信息和该作者的所有文章
 */
import { getCollection } from 'astro:content'
import PageLayout from '../../layouts/PageLayout.astro'
import PostList from '../../components/blog/PostList.astro'
import {
  getAuthors,
  getPostLayout,
  shouldShowPostImage,
  getExcerptLength,
} from '../../utils/config'

// 获取帖子配置
const postLayout = getPostLayout()
const showImage = shouldShowPostImage()
const excerptLength = getExcerptLength()

export async function getStaticPaths() {
  // 获取所有作者内容
  const authorEntries = await getCollection('authors')

  // 获取所有博客文章
  const allPosts = await getCollection('posts', ({ data }) => {
    return data.draft !== true
  })

  // 为每个作者生成路径
  return authorEntries.map((author) => {
    // 过滤出该作者的文章
    const filteredPosts = allPosts.filter((post) => post.data.author === author.slug)

    // 按发布日期降序排列
    const sortedPosts = filteredPosts.sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    )

    return {
      params: { slug: author.slug },
      props: {
        posts: sortedPosts,
        author,
      },
    }
  })
}

interface Props {
  posts: Awaited<ReturnType<typeof getCollection<'posts'>>>
  author: Awaited<ReturnType<typeof getCollection<'authors'>>>[number]
}

const { posts, author } = Astro.props
const { Content } = await author.render()
---

<PageLayout
  title={`作者: ${author.data.name}`}
  description={author.data.bio || `${author.data.name} 的文章列表`}
  containerSize="lg"
>
  <nav class="author-breadcrumb" aria-label="面包屑导航">
    <a href="/posts" class="author-breadcrumb__link">文章</a>
    <span class="author-breadcrumb__separator" aria-hidden="true">/</span>
    <span class="author-breadcrumb__current">{author.data.name}</span>
  </nav>

  <div class="author-profile">
    <div class="author-profile__header">
      {
        author.data.avatar ? (
          <img src={author.data.avatar} alt={author.data.name} class="author-profile__avatar" />
        ) : (
          <div class="author-profile__avatar author-profile__avatar--placeholder">
            <span>{author.data.name.charAt(0)}</span>
          </div>
        )
      }
      <div class="author-profile__info">
        <h1 class="author-profile__name">{author.data.name}</h1>
        {author.data.bio && <p class="author-profile__bio">{author.data.bio}</p>}
        <div class="author-profile__meta">
          {
            author.data.email && (
              <a href={`mailto:${author.data.email}`} class="author-profile__email">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                </svg>
                {author.data.email}
              </a>
            )
          }
          <span class="author-profile__post-count">{posts.length} 篇文章</span>
        </div>
      </div>
    </div>

    {/* 社交链接 */}
    {
      author.data.social && (
        <div class="author-profile__social">
          {author.data.social.github && (
            <a
              href={author.data.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="author-profile__social-link"
              title="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )}
          {author.data.social.twitter && (
            <a
              href={author.data.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="author-profile__social-link"
              title="Twitter"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
              </svg>
            </a>
          )}
          {author.data.social.website && (
            <a
              href={author.data.social.website}
              target="_blank"
              rel="noopener noreferrer"
              class="author-profile__social-link"
              title="网站"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          )}
          {author.data.social.linkedin && (
            <a
              href={author.data.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="author-profile__social-link"
              title="LinkedIn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          )}
        </div>
      )
    }

    {/* 作者详细介绍 */}
    <div class="author-profile__content prose">
      <Content />
    </div>
  </div>

  {/* 作者文章列表 */}
  <section class="author-posts">
    <h2 class="author-posts__title">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z"
          clip-rule="evenodd"></path>
        <path d="M15 7h1a2 2 0 012 2v5.5a1.5 1.5 0 01-3 0V7z"></path>
      </svg>
      文章列表
    </h2>
    {
      posts.length > 0 ? (
        <PostList
          posts={posts}
          layout={postLayout}
          columns={2}
          showCategory={true}
          showTags={true}
          showImage={showImage}
          excerptLength={excerptLength}
          context="all"
        />
      ) : (
        <p class="author-posts__empty">该作者暂无文章</p>
      )
    }
  </section>
</PageLayout>

<style>
  /* 面包屑导航 */
  .author-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .author-breadcrumb__link {
    color: var(--md-on-surface-variant);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .author-breadcrumb__link:hover {
    color: var(--md-primary);
  }

  .author-breadcrumb__separator {
    color: var(--md-outline);
  }

  .author-breadcrumb__current {
    color: var(--md-on-surface);
    font-weight: var(--font-medium);
  }

  /* 作者资料卡片 */
  .author-profile {
    margin-bottom: var(--space-10);
    padding: var(--space-6);
    background-color: var(--md-surface-container-low);
    border-radius: var(--radius-lg);
    border: 1px solid var(--md-outline-variant);
  }

  .author-profile__header {
    display: flex;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .author-profile__avatar {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--md-primary);
  }

  .author-profile__avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--md-primary);
    color: var(--md-on-primary);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
  }

  .author-profile__info {
    flex: 1;
    min-width: 0;
  }

  .author-profile__name {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--md-on-surface);
    margin: 0 0 var(--space-2) 0;
  }

  .author-profile__bio {
    font-size: var(--text-base);
    color: var(--md-on-surface-variant);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--leading-relaxed);
  }

  .author-profile__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--md-outline);
  }

  .author-profile__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--md-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .author-profile__email:hover {
    color: var(--md-tertiary);
  }

  .author-profile__email svg {
    width: 1em;
    height: 1em;
  }

  .author-profile__post-count {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    background-color: var(--md-primary-container);
    color: var(--md-on-primary-container);
    border-radius: var(--radius-sm);
    font-weight: var(--font-medium);
  }

  /* 社交链接 */
  .author-profile__social {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--md-outline-variant);
  }

  .author-profile__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background-color: var(--md-surface-container);
    color: var(--md-on-surface-variant);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .author-profile__social-link:hover {
    background-color: var(--md-primary);
    color: var(--md-on-primary);
  }

  .author-profile__social-link svg {
    width: 20px;
    height: 20px;
  }

  /* 作者详细介绍 */
  .author-profile__content {
    padding-top: var(--space-4);
    border-top: 1px solid var(--md-outline-variant);
  }

  .author-profile__content.prose {
    color: var(--md-on-surface-variant);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .author-profile__content.prose :global(h1),
  .author-profile__content.prose :global(h2),
  .author-profile__content.prose :global(h3) {
    color: var(--md-on-surface);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .author-profile__content.prose :global(h1) {
    font-size: var(--text-xl);
  }

  .author-profile__content.prose :global(h2) {
    font-size: var(--text-lg);
  }

  .author-profile__content.prose :global(ul),
  .author-profile__content.prose :global(ol) {
    margin-bottom: var(--space-4);
  }

  /* 文章列表区域 */
  .author-posts {
    margin-bottom: var(--space-12);
  }

  .author-posts__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--md-on-surface);
    margin-bottom: var(--space-6);
  }

  .author-posts__title svg {
    width: 1.25em;
    height: 1.25em;
    color: var(--md-primary);
  }

  .author-posts__empty {
    text-align: center;
    color: var(--md-on-surface-variant);
    padding: var(--space-8);
    background-color: var(--md-surface-container-low);
    border-radius: var(--radius-lg);
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .author-profile {
      padding: var(--space-4);
    }

    .author-profile__header {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .author-profile__avatar {
      width: 80px;
      height: 80px;
    }

    .author-profile__meta {
      flex-direction: column;
      gap: var(--space-2);
    }

    .author-profile__social {
      justify-content: center;
    }
  }
</style>
