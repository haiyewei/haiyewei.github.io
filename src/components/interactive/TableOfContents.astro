---
/**
 * TableOfContents 目录组件
 * 显示文章目录，支持滚动高亮和折叠展开
 * 使用原生 JavaScript 实现
 */
import { Icon } from 'astro-icon/components';

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  /** 标题列表 */
  headings: TocItem[];
  /** 自定义类名 */
  class?: string;
}

const { headings, class: className = '' } = Astro.props;

// 如果没有标题，不渲染
if (headings.length === 0) {
  return null;
}

// 计算缩进级别（基于最小深度）
const minDepth = Math.min(...headings.map((h) => h.depth));
---

<nav class:list={['toc-container', className]} aria-label="文章目录" data-toc-container>
  <button
    type="button"
    class="toc-header"
    aria-expanded="true"
    aria-controls="toc-list"
    data-toc-toggle
  >
    <span class="toc-header-content">
      <!-- 目录图标 -->
      <Icon name="material-symbols:toc" size={18} aria-hidden="true" />
      <span class="toc-title">目录</span>
    </span>
    <!-- 展开/折叠图标 -->
    <Icon name="material-symbols:keyboard-arrow-down" class="toc-chevron" size={16} aria-hidden="true" />
  </button>

  <div id="toc-list" class="toc-content expanded" data-toc-content>
    <ul class="toc-list">
      {headings.map((heading) => {
        const indent = heading.depth - minDepth;
        return (
          <li class={`toc-item depth-${indent}`} data-toc-item data-slug={heading.slug}>
            <a href={`#${heading.slug}`} class="toc-link" data-toc-link>
              {heading.text}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .toc-container {
    background-color: var(--md-surface-container-low);
    border: 1px solid var(--md-outline-variant);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 16px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--md-on-surface);
    transition: background-color var(--transition-fast, 150ms ease);
  }

  .toc-header:hover {
    background-color: var(--md-surface-container);
  }

  .toc-header-content {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-title {
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-semibold, 600);
  }

  .toc-chevron {
    transition: transform 200ms ease;
  }

  .toc-header[aria-expanded="true"] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-header[aria-expanded="false"] .toc-chevron {
    transform: rotate(0deg);
  }

  .toc-content {
    overflow: hidden;
    transition: max-height 300ms ease, opacity 200ms ease;
  }

  .toc-content.expanded {
    max-height: calc(100vh - 200px);
    opacity: 1;
    overflow-y: auto;
  }

  .toc-content.collapsed {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
  }

  /* 自定义滚动条样式 */
  .toc-content::-webkit-scrollbar {
    width: 6px;
  }

  .toc-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-content::-webkit-scrollbar-thumb {
    background-color: var(--md-outline-variant);
    border-radius: 3px;
  }

  .toc-content::-webkit-scrollbar-thumb:hover {
    background-color: var(--md-outline);
  }

  /* Firefox 滚动条样式 */
  .toc-content {
    scrollbar-width: thin;
    scrollbar-color: var(--md-outline-variant) transparent;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0 16px 16px;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-item.depth-0 {
    padding-left: 0;
  }

  .toc-item.depth-1 {
    padding-left: 16px;
  }

  .toc-item.depth-2 {
    padding-left: 32px;
  }

  .toc-item.depth-3 {
    padding-left: 48px;
  }

  .toc-link {
    display: block;
    padding: 6px 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-on-surface-variant);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 12px;
    margin-left: -12px;
    transition: color var(--transition-fast, 150ms ease),
                border-color var(--transition-fast, 150ms ease);
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--md-on-surface);
  }

  .toc-item.active .toc-link {
    color: var(--md-primary);
    border-left-color: var(--md-primary);
    font-weight: var(--font-medium, 500);
  }

  /* 响应式 - 移动端默认折叠 */
  @media (max-width: 1024px) {
    .toc-container {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: auto;
      max-width: 280px;
      z-index: var(--z-fixed, 300);
      box-shadow: var(--shadow-lg);
    }

    .toc-content.expanded {
      max-height: 300px;
      overflow-y: auto;
    }
  }

  @media (max-width: 640px) {
    .toc-container {
      bottom: 16px;
      right: 16px;
      left: 16px;
      max-width: none;
    }
  }
</style>

<script>
  /**
   * 目录组件逻辑
   */
  (function initTableOfContents() {
    const containers = document.querySelectorAll<HTMLElement>('[data-toc-container]');

    containers.forEach((container) => {
      const toggleBtn = container.querySelector<HTMLButtonElement>('[data-toc-toggle]');
      const content = container.querySelector<HTMLDivElement>('[data-toc-content]');
      const items = container.querySelectorAll<HTMLLIElement>('[data-toc-item]');
      const links = container.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');

      if (!toggleBtn || !content || items.length === 0) return;

      let isExpanded = true;
      let activeId = '';

      // 切换展开/折叠
      toggleBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        toggleBtn.setAttribute('aria-expanded', String(isExpanded));
        content.classList.toggle('expanded', isExpanded);
        content.classList.toggle('collapsed', !isExpanded);
      });

      // 点击链接跳转
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const href = link.getAttribute('href');
          if (!href) return;

          const slug = href.slice(1); // 移除 #
          const element = document.getElementById(slug);
          if (!element) return;

          const navHeight = 80; // 导航栏高度
          const elementPosition = element.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - navHeight;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth',
          });

          // 更新 URL hash
          history.pushState(null, '', `#${slug}`);
          setActiveId(slug);
        });
      });

      // 设置活动项
      function setActiveId(id: string): void {
        activeId = id;
        items.forEach((item) => {
          const isActive = item.dataset.slug === id;
          item.classList.toggle('active', isActive);
          const link = item.querySelector('[data-toc-link]');
          if (link) {
            if (isActive) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          }
        });
      }

      // 监听滚动，更新当前活动标题
      const slugs = Array.from(items).map((item) => item.dataset.slug).filter(Boolean) as string[];
      
      if (slugs.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setActiveId(entry.target.id);
              }
            });
          },
          {
            rootMargin: '-80px 0px -80% 0px',
            threshold: 0,
          }
        );

        // 观察所有标题元素
        slugs.forEach((slug) => {
          const element = document.getElementById(slug);
          if (element) {
            observer.observe(element);
          }
        });
      }
    });
  })();
</script>