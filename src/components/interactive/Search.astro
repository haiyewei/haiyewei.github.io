---
/**
 * Search 搜索组件
 * 可展开/收起的搜索框，默认显示搜索图标按钮
 * 点击后展开搜索输入框，点击外部或按 ESC 收起
 * 使用原生 JavaScript 实现
 */
import { Icon } from 'astro-icon/components'

interface Props {
  /** 搜索框占位符文本 */
  placeholder?: string
  /** 自定义类名 */
  class?: string
}

const { placeholder = '搜索文章...', class: className = '' } = Astro.props
---

<div class:list={['search-container', className]} data-search-container>
  {/* 搜索按钮 - 默认显示 */}
  <button
    type="button"
    class="search-toggle-btn"
    aria-label="打开搜索"
    aria-expanded="false"
    data-search-toggle
  >
    <Icon name="material-symbols:search" size={20} aria-hidden="true" />
  </button>

  {/* 展开的搜索框 */}
  <div class="search-expanded" data-search-expanded hidden>
    <div class="search-modal-card" data-search-card>
      <div class="search-input-wrapper">
        <span class="search-icon">
          <Icon name="material-symbols:search" size={18} aria-hidden="true" />
        </span>
        <input
          type="text"
          placeholder={placeholder}
          class="search-input"
          aria-label="搜索文章"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          role="combobox"
          data-search-input
        />
        <button type="button" class="search-close" aria-label="关闭搜索" data-search-close>
          <Icon name="material-symbols:close" size={18} aria-hidden="true" />
        </button>
      </div>

      <div class="search-dropdown" role="listbox" id="search-results" data-search-dropdown hidden>
        <div class="search-loading" data-search-loading hidden>加载中...</div>
        <ul class="search-results" data-search-results></ul>
        <div class="search-no-results" data-search-no-results hidden>未找到相关文章</div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 搜索按钮 */
  .search-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    color: var(--md-on-surface);
    cursor: pointer;
    border-radius: var(--radius-md, 8px);
    transition:
      background-color var(--transition-fast, 150ms ease),
      color var(--transition-fast, 150ms ease);
  }

  .search-toggle-btn:hover {
    background-color: var(--md-surface-variant);
    color: var(--md-primary);
  }

  .search-toggle-btn:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }

  /* 展开的搜索遮罩（使用 MD3 主题的 scrim 遮罩色） */
  .search-expanded {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background-color: color-mix(in srgb, var(--md-scrim) 60%, transparent); /* 吃到主题系统自带的 --md-scrim 变量 */
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 20px 20px;
    animation: backdropFadeIn 0.25s ease-out forwards;
  }

  [data-theme='dark'] .search-expanded {
    background-color: color-mix(in srgb, var(--md-scrim) 75%, transparent); /* 暗色模式下遮罩加深以获得更好对比度 */
  }

  @keyframes backdropFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .search-expanded[hidden] {
    display: none;
  }

  /* 居中的搜索对话框卡片 */
  .search-modal-card {
    background-color: var(--md-surface-container-high);
    border: 1px solid var(--md-primary);
    border-radius: var(--radius-lg, 12px);
    width: 100%;
    max-width: 760px; /* 拓宽搜索框，从 600px 提升到 760px */
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: 
      cardSlideDown 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards,
      searchBoxBreathe 3s ease-in-out infinite;
  }

  @keyframes cardSlideDown {
    from {
      opacity: 0;
      transform: translateY(-24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes searchBoxBreathe {
    0% {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 1px var(--md-primary), var(--shadow-xl);
    }
    50% {
      border-color: color-mix(in srgb, var(--md-primary) 40%, transparent);
      box-shadow: 0 0 12px 2px color-mix(in srgb, var(--md-primary) 30%, transparent), var(--shadow-xl);
    }
    100% {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 1px var(--md-primary), var(--shadow-xl);
    }
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 14px 16px;
    border-bottom: 1px solid var(--md-outline-variant);
  }

  .search-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--md-primary);
    pointer-events: none;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0 12px;
    font-size: 1rem;
    color: var(--md-on-surface);
    background: transparent;
    border: none;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--md-outline);
  }

  .search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    background: none;
    border: none;
    color: var(--md-on-surface-variant);
    cursor: pointer;
    border-radius: var(--radius-full, 9999px);
    transition:
      color var(--transition-fast, 150ms ease),
      background-color var(--transition-fast, 150ms ease);
  }

  .search-close:hover {
    color: var(--md-on-surface);
    background-color: var(--md-surface-variant);
  }

  .search-close:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }

  .search-dropdown {
    width: 100%;
    background-color: var(--md-surface-container-high);
    max-height: 400px;
    overflow-y: auto;
  }

  .search-loading,
  .search-no-results {
    padding: 16px;
    text-align: center;
    color: var(--md-on-surface-variant);
    font-size: var(--text-sm, 0.875rem);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }

  .search-results:empty {
    display: none;
  }

  :global(.search-result-item) {
    padding: 12px 16px;
    cursor: pointer;
    transition: background-color var(--transition-fast, 150ms ease);
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background-color: var(--md-surface-variant);
  }

  :global(.search-result-title) {
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-medium, 500);
    color: var(--md-on-surface);
    margin-bottom: 4px;
  }

  :global(.search-result-description) {
    font-size: var(--text-xs, 0.75rem);
    color: var(--md-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 6px;
  }

  :global(.search-result-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  :global(.search-result-tag) {
    font-size: var(--text-xs, 0.75rem);
    padding: 2px 6px;
    background-color: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
    border-radius: var(--radius-sm, 4px);
  }

  /* 搜索匹配文本高亮样式 */
  :global(.search-highlight) {
    background-color: var(--md-tertiary-container, #ffd8e4);
    color: var(--md-on-tertiary-container, #31111d);
    border-radius: 2px;
    padding: 0 2px;
    font-weight: inherit;
  }

  [data-theme='dark'] :global(.search-highlight) {
    background-color: var(--md-tertiary-container, #633b48);
    color: var(--md-on-tertiary-container, #ffd8e4);
  }

  /* 移动端响应式 */
  @media (max-width: 640px) {
    .search-expanded {
      position: fixed;
      top: var(--space-2, 8px);
      left: var(--space-2, 8px);
      right: var(--space-2, 8px);
      width: auto;
      transform: none;
    }
  }
</style>

<script>
  /**
   * 搜索组件逻辑
   * 支持展开/收起搜索框
   */
  interface SearchResult {
    title: string
    description: string
    slug: string
    category?: string
    tags?: string[]
    body?: string
  }

  ;(function initSearch() {
    const containers = document.querySelectorAll<HTMLDivElement>('[data-search-container]')

    containers.forEach((container) => {
      const toggleBtn = container.querySelector<HTMLButtonElement>('[data-search-toggle]')!
      const expandedEl = container.querySelector<HTMLDivElement>('[data-search-expanded]')!
      const input = container.querySelector<HTMLInputElement>('[data-search-input]')!
      const closeBtn = container.querySelector<HTMLButtonElement>('[data-search-close]')!
      const dropdown = container.querySelector<HTMLDivElement>('[data-search-dropdown]')!
      const loadingEl = container.querySelector<HTMLDivElement>('[data-search-loading]')!
      const resultsEl = container.querySelector<HTMLUListElement>('[data-search-results]')!
      const noResultsEl = container.querySelector<HTMLDivElement>('[data-search-no-results]')!

      if (
        !toggleBtn ||
        !expandedEl ||
        !input ||
        !closeBtn ||
        !dropdown ||
        !loadingEl ||
        !resultsEl ||
        !noResultsEl
      )
        return

      let searchData: SearchResult[] = []
      let results: SearchResult[] = []
      let selectedIndex = -1
      let isDropdownOpen = false
      let isSearchExpanded = false
      let isLoading = false

      // HTML 转义辅助函数，防止 XSS
      function escapeHtml(str: string): string {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;')
      }

      // 对文本中的查询词进行高亮
      function highlightText(text: string, query: string): string | null {
        if (!text || !query) return null
        const index = text.toLowerCase().indexOf(query.toLowerCase())
        if (index === -1) return null

        const escapedText = escapeHtml(text)
        const escapedQuery = escapeHtml(query)
        const regex = new RegExp(`(${escapedQuery.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&')})`, 'gi')
        return escapedText.replace(regex, '<mark class="search-highlight">$1</mark>')
      }

      // 获取包含匹配词的预览上下文片段
      function getHighlightSnippet(text: string, query: string, maxLength = 120): string | null {
        if (!text || !query) return null
        const index = text.toLowerCase().indexOf(query.toLowerCase())
        if (index === -1) return null

        // 计算预览片段范围，尽量让匹配词居中
        let start = Math.max(0, index - Math.floor(maxLength / 2))
        let end = Math.min(text.length, index + query.length + Math.floor(maxLength / 2))

        let snippet = text.substring(start, end)
        let prefix = start > 0 ? '...' : ''
        let suffix = end < text.length ? '...' : ''

        const escapedSnippet = escapeHtml(snippet)
        const escapedQuery = escapeHtml(query)

        const regex = new RegExp(`(${escapedQuery.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&')})`, 'gi')
        const highlighted = escapedSnippet.replace(regex, '<mark class="search-highlight">$1</mark>')

        return prefix + highlighted + suffix
      }

      // 展开搜索框
      function expandSearch(): void {
        if (isSearchExpanded) return
        isSearchExpanded = true
        container.classList.add('expanded')
        expandedEl.hidden = false
        toggleBtn.setAttribute('aria-expanded', 'true')

        // 锁定背景页面滚动条，并动态补偿滚动条宽度，防止页面内容左右抖动（Layout Shift）
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth
        if (scrollbarWidth > 0) {
          document.body.style.paddingRight = `${scrollbarWidth}px`
        }
        document.body.style.overflow = 'hidden'

        // 延迟聚焦，等待动画
        requestAnimationFrame(() => {
          input.focus()
        })
      }

      // 收起搜索框
      function collapseSearch(): void {
        if (!isSearchExpanded) return
        isSearchExpanded = false
        container.classList.remove('expanded')
        expandedEl.hidden = true
        toggleBtn.setAttribute('aria-expanded', 'false')

        // 恢复背景页面滚动条及内边距补偿
        document.body.style.overflow = ''
        document.body.style.paddingRight = ''

        // 清空搜索
        input.value = ''
        results = []
        selectedIndex = -1
        renderResults()
        closeDropdown()
      }

      // 加载搜索数据
      async function loadSearchData(): Promise<void> {
        if (searchData.length > 0 || isLoading) return

        try {
          isLoading = true
          showLoading(true)
          const response = await fetch('/api/search.json')
          if (response.ok) {
            searchData = await response.json()
          }
        } catch (error) {
          console.error('加载搜索数据失败:', error)
        } finally {
          isLoading = false
          showLoading(false)
        }
      }

      // 显示/隐藏加载状态
      function showLoading(show: boolean): void {
        loadingEl.hidden = !show
      }

      // 执行搜索
      function performSearch(query: string): void {
        if (!query.trim()) {
          results = []
          renderResults()
          return
        }

        const lowerQuery = query.toLowerCase()
        results = searchData
          .filter((item) => {
            const titleMatch = item.title.toLowerCase().includes(lowerQuery)
            const descMatch = item.description.toLowerCase().includes(lowerQuery)
            const tagMatch = item.tags?.some((tag) => tag.toLowerCase().includes(lowerQuery))
            const categoryMatch = item.category?.toLowerCase().includes(lowerQuery)
            const contentMatch = item.body?.toLowerCase().includes(lowerQuery)
            return titleMatch || descMatch || tagMatch || categoryMatch || contentMatch
          })
          .slice(0, 5)

        selectedIndex = -1
        renderResults()
      }

      // 渲染搜索结果
      function renderResults(): void {
        resultsEl.innerHTML = ''

        if (results.length === 0) {
          noResultsEl.hidden = !input.value.trim()
          return
        }

        noResultsEl.hidden = true

        results.forEach((result, index) => {
          const li = document.createElement('li')
          li.className = `search-result-item${index === selectedIndex ? ' selected' : ''}`
          li.setAttribute('role', 'option')
          li.setAttribute('aria-selected', String(index === selectedIndex))
          li.dataset.index = String(index)

          const titleEl = document.createElement('div')
          titleEl.className = 'search-result-title'
          
          const query = input.value.trim()
          const titleHighlight = highlightText(result.title, query)
          if (titleHighlight) {
            titleEl.innerHTML = titleHighlight
          } else {
            titleEl.textContent = result.title
          }

          const descriptionEl = document.createElement('div')
          descriptionEl.className = 'search-result-description'
          
          const snippetHtml = getHighlightSnippet(result.body || '', query)
          if (snippetHtml) {
            descriptionEl.innerHTML = snippetHtml
          } else {
            const descHighlight = highlightText(result.description, query)
            if (descHighlight) {
              descriptionEl.innerHTML = descHighlight
            } else {
              descriptionEl.textContent = result.description
            }
          }

          li.append(titleEl, descriptionEl)

          if (result.tags && result.tags.length > 0) {
            const tagsEl = document.createElement('div')
            tagsEl.className = 'search-result-tags'
            result.tags.slice(0, 3).forEach((tag) => {
              const tagEl = document.createElement('span')
              tagEl.className = 'search-result-tag'
              tagEl.textContent = tag
              tagsEl.appendChild(tagEl)
            })
            li.appendChild(tagsEl)
          }

          li.addEventListener('click', () => navigateToResult(result))
          li.addEventListener('mouseenter', () => {
            selectedIndex = index
            updateSelection()
          })

          resultsEl.appendChild(li)
        })
      }

      // 更新选中状态
      function updateSelection(): void {
        const items = resultsEl.querySelectorAll('.search-result-item')
        items.forEach((item, index) => {
          const isSelected = index === selectedIndex
          item.classList.toggle('selected', isSelected)
          item.setAttribute('aria-selected', String(isSelected))
        })

        // 滚动到可见区域
        if (selectedIndex >= 0) {
          const selectedItem = items[selectedIndex] as HTMLElement
          selectedItem?.scrollIntoView({ block: 'nearest' })
        }
      }

      // 导航到结果
      function navigateToResult(result: SearchResult): void {
        collapseSearch() // 跳转前先关闭并解锁滚动
        window.location.href = `/${result.slug}`
      }

      // 打开下拉框
      function openDropdown(): void {
        isDropdownOpen = true
        dropdown.hidden = false
        input.setAttribute('aria-expanded', 'true')
      }

      // 关闭下拉框
      function closeDropdown(): void {
        isDropdownOpen = false
        dropdown.hidden = true
        input.setAttribute('aria-expanded', 'false')
      }

      // 事件监听 - 搜索按钮点击
      toggleBtn.addEventListener('click', () => {
        expandSearch()
        loadSearchData()
      })

      // 事件监听 - 关闭按钮点击
      closeBtn.addEventListener('click', collapseSearch)

      // 事件监听 - 输入
      input.addEventListener('input', () => {
        const query = input.value
        performSearch(query)
        if (query) {
          openDropdown()
        } else {
          closeDropdown()
        }
      })

      input.addEventListener('focus', async () => {
        await loadSearchData()
        if (input.value) {
          openDropdown()
        }
      })

      input.addEventListener('keydown', (e) => {
        switch (e.key) {
          case 'ArrowDown':
            if (isDropdownOpen) {
              e.preventDefault()
              selectedIndex = Math.min(selectedIndex + 1, results.length - 1)
              updateSelection()
            }
            break
          case 'ArrowUp':
            if (isDropdownOpen) {
              e.preventDefault()
              selectedIndex = Math.max(selectedIndex - 1, -1)
              updateSelection()
            }
            break
          case 'Enter':
            if (isDropdownOpen && selectedIndex >= 0 && results[selectedIndex]) {
              e.preventDefault()
              navigateToResult(results[selectedIndex])
            }
            break
          case 'Escape':
            e.preventDefault()
            collapseSearch()
            break
        }
      })

          // 点击外部区域（除搜索卡片和打开按钮外）关闭搜索框
      document.addEventListener('mousedown', (e) => {
        if (!isSearchExpanded) return
        const card = container.querySelector('[data-search-card]')
        const clickedToggle = toggleBtn.contains(e.target as Node)
        if (card && !card.contains(e.target as Node) && !clickedToggle) {
          collapseSearch()
        }
      })

      // 全局快捷键 Ctrl+K / Cmd+K 或 "/" 键打开搜索框
      document.addEventListener('keydown', (e) => {
        const activeEl = document.activeElement
        if (
          activeEl &&
          (activeEl.tagName === 'INPUT' ||
            activeEl.tagName === 'TEXTAREA' ||
            (activeEl instanceof HTMLElement && activeEl.contentEditable === 'true'))
        ) {
          // 如果当前焦点就是搜索框本身，按 Esc 可以关闭
          if (activeEl === input && e.key === 'Escape') {
            collapseSearch()
          }
          return
        }

        if (
          ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') ||
          (e.key === '/' && !e.ctrlKey && !e.metaKey)
        ) {
          e.preventDefault()
          expandSearch()
          loadSearchData()
        }
      })
    })
  })()
</script>
