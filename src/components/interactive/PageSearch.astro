---
/**
 * PageSearch 页面内搜索组件
 * 用于在当前页面内搜索文本内容（类似浏览器的 Ctrl+F）
 * 支持高亮显示匹配文本、跳转到匹配位置、显示匹配数量
 */
import { Icon } from 'astro-icon/components'

interface Props {
  /** 搜索框占位符文本 */
  placeholder?: string
  /** 自定义类名 */
  class?: string
  /** 搜索的目标容器选择器 */
  targetSelector?: string
}

const {
  placeholder = '在页面中搜索...',
  class: className = '',
  targetSelector = '.article-content',
} = Astro.props
---

<div
  class:list={['page-search-container', className]}
  data-page-search-container
  data-target-selector={targetSelector}
>
  {/* 搜索按钮 - 默认显示 */}
  <button
    type="button"
    class="page-search-toggle-btn"
    aria-label="页面内搜索"
    aria-expanded="false"
    data-page-search-toggle
    title="页面内搜索 (Ctrl+F)"
  >
    <Icon name="material-symbols:find-in-page" size={20} aria-hidden="true" />
  </button>

  {/* 展开的搜索框 */}
  <div class="page-search-expanded" data-page-search-expanded hidden>
    <div class="page-search-input-wrapper">
      <span class="page-search-icon">
        <Icon name="material-symbols:search" size={18} aria-hidden="true" />
      </span>
      <input
        type="text"
        placeholder={placeholder}
        class="page-search-input"
        aria-label="页面内搜索"
        data-page-search-input
      />
      {/* 匹配计数 */}
      <span class="page-search-count" data-page-search-count hidden>
        <span data-current-match>0</span>/<span data-total-matches>0</span>
      </span>
      {/* 导航按钮 */}
      <div class="page-search-nav">
        <button
          type="button"
          class="page-search-nav-btn"
          aria-label="上一个匹配"
          data-page-search-prev
          disabled
        >
          <Icon name="material-symbols:keyboard-arrow-up" size={18} aria-hidden="true" />
        </button>
        <button
          type="button"
          class="page-search-nav-btn"
          aria-label="下一个匹配"
          data-page-search-next
          disabled
        >
          <Icon name="material-symbols:keyboard-arrow-down" size={18} aria-hidden="true" />
        </button>
      </div>
      <button type="button" class="page-search-close" aria-label="关闭搜索" data-page-search-close>
        <Icon name="material-symbols:close" size={18} aria-hidden="true" />
      </button>
    </div>
  </div>
</div>

<style>
  .page-search-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 搜索按钮 */
  .page-search-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: none;
    color: var(--md-on-surface);
    cursor: pointer;
    border-radius: var(--radius-md, 8px);
    transition:
      background-color var(--transition-fast, 150ms ease),
      color var(--transition-fast, 150ms ease);
  }

  .page-search-toggle-btn:hover {
    background-color: var(--md-surface-variant);
    color: var(--md-primary);
  }

  .page-search-toggle-btn:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }

  /* 搜索框展开时隐藏按钮 */
  .page-search-container.expanded .page-search-toggle-btn {
    display: none;
  }

  /* 展开的搜索框 */
  .page-search-expanded {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: 320px;
    z-index: var(--z-dropdown, 100);
  }

  .page-search-expanded[hidden] {
    display: none;
  }

  .page-search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--md-surface);
    border: 1px solid var(--md-outline);
    border-radius: var(--radius-md, 8px);
    box-shadow: var(--shadow-lg);
    transition:
      border-color var(--transition-fast, 150ms ease),
      box-shadow var(--transition-fast, 150ms ease);
  }

  .page-search-input-wrapper:focus-within {
    border-color: var(--md-primary);
    box-shadow:
      var(--shadow-lg),
      0 0 0 3px color-mix(in srgb, var(--md-primary) 20%, transparent);
  }

  .page-search-icon {
    position: absolute;
    left: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--md-outline);
    pointer-events: none;
  }

  .page-search-input {
    flex: 1;
    min-width: 0;
    padding: 10px 8px 10px 36px;
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-on-surface);
    background: transparent;
    border: none;
    outline: none;
  }

  .page-search-input::placeholder {
    color: var(--md-outline);
  }

  /* 匹配计数 */
  .page-search-count {
    display: flex;
    align-items: center;
    padding: 0 8px;
    font-size: var(--text-xs, 0.75rem);
    color: var(--md-on-surface-variant);
    white-space: nowrap;
    border-left: 1px solid var(--md-outline-variant);
  }

  .page-search-count[hidden] {
    display: none;
  }

  /* 导航按钮 */
  .page-search-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 4px;
    border-left: 1px solid var(--md-outline-variant);
  }

  .page-search-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    background: none;
    border: none;
    color: var(--md-on-surface);
    cursor: pointer;
    border-radius: var(--radius-sm, 4px);
    transition:
      color var(--transition-fast, 150ms ease),
      background-color var(--transition-fast, 150ms ease);
  }

  .page-search-nav-btn:hover:not(:disabled) {
    color: var(--md-primary);
    background-color: var(--md-surface-variant);
  }

  .page-search-nav-btn:disabled {
    color: var(--md-outline);
    cursor: not-allowed;
  }

  .page-search-nav-btn:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }

  .page-search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-right: 4px;
    padding: 0;
    background: none;
    border: none;
    color: var(--md-outline);
    cursor: pointer;
    border-radius: var(--radius-sm, 4px);
    transition:
      color var(--transition-fast, 150ms ease),
      background-color var(--transition-fast, 150ms ease);
  }

  .page-search-close:hover {
    color: var(--md-on-surface);
    background-color: var(--md-surface-variant);
  }

  .page-search-close:focus-visible {
    outline: 2px solid var(--md-primary);
    outline-offset: 2px;
  }

  /* 移动端响应式 */
  @media (max-width: 640px) {
    .page-search-expanded {
      position: fixed;
      top: var(--space-2, 8px);
      left: var(--space-2, 8px);
      right: var(--space-2, 8px);
      width: auto;
      transform: none;
    }
  }
</style>

<style is:global>
  /* 高亮匹配文本样式 */
  .page-search-highlight {
    background-color: var(--md-tertiary-container, #ffd8e4);
    color: var(--md-on-tertiary-container, #31111d);
    border-radius: 2px;
    padding: 0 1px;
  }

  /* 当前匹配项高亮 */
  .page-search-highlight.current {
    background-color: var(--md-primary, #6750a4);
    color: var(--md-on-primary, #ffffff);
  }

  /* 暗色模式下的高亮颜色 */
  [data-theme='dark'] .page-search-highlight {
    background-color: var(--md-tertiary-container, #633b48);
    color: var(--md-on-tertiary-container, #ffd8e4);
  }

  [data-theme='dark'] .page-search-highlight.current {
    background-color: var(--md-primary, #d0bcff);
    color: var(--md-on-primary, #381e72);
  }
</style>

<script>
  /**
   * 页面内搜索组件逻辑
   * 支持文本搜索、高亮显示、导航跳转
   */
  interface HighlightInfo {
    element: HTMLElement
    originalParent: Node
    originalNextSibling: Node | null
  }

  ;(function initPageSearch() {
    const containers = document.querySelectorAll<HTMLDivElement>('[data-page-search-container]')

    containers.forEach((container) => {
      const targetSelector = container.dataset.targetSelector || '.article-content'
      const toggleBtn = container.querySelector<HTMLButtonElement>('[data-page-search-toggle]')
      const expandedEl = container.querySelector<HTMLDivElement>('[data-page-search-expanded]')
      const input = container.querySelector<HTMLInputElement>('[data-page-search-input]')
      const closeBtn = container.querySelector<HTMLButtonElement>('[data-page-search-close]')
      const countEl = container.querySelector<HTMLSpanElement>('[data-page-search-count]')
      const currentMatchEl = container.querySelector<HTMLSpanElement>('[data-current-match]')
      const totalMatchesEl = container.querySelector<HTMLSpanElement>('[data-total-matches]')
      const prevBtn = container.querySelector<HTMLButtonElement>('[data-page-search-prev]')
      const nextBtn = container.querySelector<HTMLButtonElement>('[data-page-search-next]')

      if (
        !toggleBtn ||
        !expandedEl ||
        !input ||
        !closeBtn ||
        !countEl ||
        !currentMatchEl ||
        !totalMatchesEl ||
        !prevBtn ||
        !nextBtn
      ) {
        return
      }

      let isExpanded = false
      let highlights: HighlightInfo[] = []
      let currentIndex = -1
      let searchTimeout: ReturnType<typeof setTimeout> | null = null

      // 获取搜索目标容器
      function getTargetContainer(): HTMLElement | null {
        return document.querySelector<HTMLElement>(targetSelector)
      }

      // 展开搜索框
      function expandSearch(): void {
        isExpanded = true
        container.classList.add('expanded')
        expandedEl.hidden = false
        toggleBtn.setAttribute('aria-expanded', 'true')

        requestAnimationFrame(() => {
          input.focus()
        })
      }

      // 收起搜索框
      function collapseSearch(): void {
        isExpanded = false
        container.classList.remove('expanded')
        expandedEl.hidden = true
        toggleBtn.setAttribute('aria-expanded', 'false')

        // 清空搜索
        input.value = ''
        clearHighlights()
        updateCount(0, 0)
      }

      // 清除所有高亮
      function clearHighlights(): void {
        highlights.forEach(({ element }) => {
          const parent = element.parentNode
          if (parent) {
            // 将高亮元素的文本内容还原
            const textNode = document.createTextNode(element.textContent || '')
            parent.replaceChild(textNode, element)
            // 合并相邻的文本节点
            parent.normalize()
          }
        })
        highlights = []
        currentIndex = -1
      }

      // 更新匹配计数显示
      function updateCount(current: number, total: number): void {
        if (total === 0) {
          countEl.hidden = true
          prevBtn.disabled = true
          nextBtn.disabled = true
        } else {
          countEl.hidden = false
          currentMatchEl.textContent = String(current)
          totalMatchesEl.textContent = String(total)
          prevBtn.disabled = total <= 1
          nextBtn.disabled = total <= 1
        }
      }

      // 执行搜索
      function performSearch(query: string): void {
        clearHighlights()

        if (!query.trim()) {
          updateCount(0, 0)
          return
        }

        const targetContainer = getTargetContainer()
        if (!targetContainer) {
          updateCount(0, 0)
          return
        }

        // 搜索并高亮文本
        const matches = highlightText(targetContainer, query)

        if (matches.length > 0) {
          currentIndex = 1
          updateCount(currentIndex, matches.length)
          scrollToMatch(currentIndex - 1)
        } else {
          updateCount(0, 0)
        }
      }

      // 高亮文本
      function highlightText(container: HTMLElement, query: string): HighlightInfo[] {
        const matches: HighlightInfo[] = []
        const lowerQuery = query.toLowerCase()

        // 使用 TreeWalker 遍历所有文本节点
        const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
          acceptNode: (node) => {
            // 跳过脚本和样式标签内的文本
            const parent = node.parentElement
            if (!parent) return NodeFilter.FILTER_REJECT
            const tagName = parent.tagName.toLowerCase()
            if (tagName === 'script' || tagName === 'style' || tagName === 'noscript') {
              return NodeFilter.FILTER_REJECT
            }
            // 跳过已经高亮的元素
            if (parent.classList.contains('page-search-highlight')) {
              return NodeFilter.FILTER_REJECT
            }
            return NodeFilter.FILTER_ACCEPT
          },
        })

        const textNodes: Text[] = []
        let node: Node | null
        while ((node = walker.nextNode())) {
          textNodes.push(node as Text)
        }

        // 处理每个文本节点
        textNodes.forEach((textNode) => {
          const text = textNode.textContent || ''
          const lowerText = text.toLowerCase()
          let lastIndex = 0
          let index: number

          const fragments: (string | HTMLElement)[] = []
          let hasMatch = false

          while ((index = lowerText.indexOf(lowerQuery, lastIndex)) !== -1) {
            hasMatch = true

            // 添加匹配前的文本
            if (index > lastIndex) {
              fragments.push(text.substring(lastIndex, index))
            }

            // 创建高亮元素
            const highlight = document.createElement('mark')
            highlight.className = 'page-search-highlight'
            highlight.textContent = text.substring(index, index + query.length)
            fragments.push(highlight)

            matches.push({
              element: highlight,
              originalParent: textNode.parentNode!,
              originalNextSibling: textNode.nextSibling,
            })

            lastIndex = index + query.length
          }

          // 添加剩余文本
          if (hasMatch) {
            if (lastIndex < text.length) {
              fragments.push(text.substring(lastIndex))
            }

            // 替换原文本节点
            const parent = textNode.parentNode
            if (parent) {
              const wrapper = document.createDocumentFragment()
              fragments.forEach((fragment) => {
                if (typeof fragment === 'string') {
                  wrapper.appendChild(document.createTextNode(fragment))
                } else {
                  wrapper.appendChild(fragment)
                }
              })
              parent.replaceChild(wrapper, textNode)
            }
          }
        })

        highlights = matches
        return matches
      }

      // 滚动到指定匹配项
      function scrollToMatch(index: number): void {
        if (index < 0 || index >= highlights.length) return

        // 移除之前的当前高亮
        highlights.forEach(({ element }) => {
          element.classList.remove('current')
        })

        // 添加当前高亮
        const current = highlights[index]
        current.element.classList.add('current')

        // 滚动到可见区域
        current.element.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        })
      }

      // 跳转到上一个匹配
      function goToPrevMatch(): void {
        if (highlights.length === 0) return

        currentIndex = currentIndex <= 1 ? highlights.length : currentIndex - 1
        updateCount(currentIndex, highlights.length)
        scrollToMatch(currentIndex - 1)
      }

      // 跳转到下一个匹配
      function goToNextMatch(): void {
        if (highlights.length === 0) return

        currentIndex = currentIndex >= highlights.length ? 1 : currentIndex + 1
        updateCount(currentIndex, highlights.length)
        scrollToMatch(currentIndex - 1)
      }

      // 防抖搜索
      function debouncedSearch(query: string): void {
        if (searchTimeout) {
          clearTimeout(searchTimeout)
        }
        searchTimeout = setTimeout(() => {
          performSearch(query)
        }, 200)
      }

      // 事件监听 - 搜索按钮点击
      toggleBtn.addEventListener('click', expandSearch)

      // 事件监听 - 关闭按钮点击
      closeBtn.addEventListener('click', collapseSearch)

      // 事件监听 - 输入
      input.addEventListener('input', () => {
        debouncedSearch(input.value)
      })

      // 事件监听 - 上一个/下一个按钮
      prevBtn.addEventListener('click', goToPrevMatch)
      nextBtn.addEventListener('click', goToNextMatch)

      // 事件监听 - 键盘快捷键
      input.addEventListener('keydown', (e) => {
        switch (e.key) {
          case 'Enter':
            e.preventDefault()
            if (e.shiftKey) {
              goToPrevMatch()
            } else {
              goToNextMatch()
            }
            break
          case 'Escape':
            e.preventDefault()
            collapseSearch()
            break
          case 'F3':
            e.preventDefault()
            if (e.shiftKey) {
              goToPrevMatch()
            } else {
              goToNextMatch()
            }
            break
        }
      })

      // 点击外部关闭
      document.addEventListener('mousedown', (e) => {
        if (isExpanded && !container.contains(e.target as Node)) {
          collapseSearch()
        }
      })

      // 全局快捷键 Ctrl+F 打开页面内搜索
      document.addEventListener('keydown', (e) => {
        // 检查是否在文章页面
        const targetContainer = getTargetContainer()
        if (!targetContainer) return

        if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
          e.preventDefault()
          if (!isExpanded) {
            expandSearch()
          } else {
            input.select()
          }
        }
      })
    })
  })()
</script>
