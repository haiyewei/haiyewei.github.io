---
/**
 * OpenGraph 组件
 * 生成 Open Graph meta 标签，用于社交媒体分享
 */
import { siteConfig } from '../../utils/config'

interface Props {
  /** 页面标题 */
  title: string
  /** 页面描述 */
  description: string
  /** 分享图片 URL */
  image?: string
  /** 页面 URL */
  url: string
  /** 内容类型 */
  type?: 'website' | 'article'
  /** 网站名称 */
  siteName?: string
  /** 语言区域 */
  locale?: string
  /** 文章发布时间 */
  publishedTime?: Date
  /** 文章修改时间 */
  modifiedTime?: Date
  /** 文章作者 */
  author?: string
  /** 文章标签 */
  tags?: string[]
}

const {
  title,
  description,
  image,
  url,
  type = 'website',
  siteName = siteConfig.site.title,
  locale = siteConfig.site.language.replace('-', '_'),
  publishedTime,
  modifiedTime,
  author,
  tags = [],
} = Astro.props

// 构建完整的图片 URL
const siteUrl = siteConfig.site.url || Astro.url.origin
const ogImage = image ? new URL(image, siteUrl).href : undefined

// 格式化日期为 ISO 8601 格式
const formatDate = (date: Date | undefined): string | undefined => {
  return date ? date.toISOString() : undefined
}
---

<!-- Open Graph 基础标签 -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />

{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:alt" content={title} />}

<!-- 文章类型的额外属性 -->
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={formatDate(publishedTime)} />
  )
}
{
  type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={formatDate(modifiedTime)} />
  )
}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
