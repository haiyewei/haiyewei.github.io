---
/**
 * SEO 综合组件
 * 整合所有 SEO 相关标签，包含 OpenGraph、TwitterCard、JsonLd
 */
import OpenGraph from './OpenGraph.astro'
import TwitterCard from './TwitterCard.astro'
import JsonLd from './JsonLd.astro'
import { siteConfig } from '../../utils/config'
import { createWebSiteSchema, createBlogPostingSchema } from './schema-helpers'

interface Props {
  /** 页面标题 */
  title: string
  /** 页面描述 */
  description: string
  /** 分享图片 URL */
  image?: string
  /** 内容类型 */
  type?: 'website' | 'article'
  /** 文章发布时间 */
  publishedTime?: Date
  /** 文章修改时间 */
  modifiedTime?: Date
  /** 文章作者 */
  author?: string
  /** 文章标签 */
  tags?: string[]
  /** 是否禁止索引 */
  noindex?: boolean
  /** 是否禁止跟踪链接 */
  nofollow?: boolean
  /** 规范 URL */
  canonical?: string
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = siteConfig.site.author,
  tags = [],
  noindex = false,
  nofollow = false,
  canonical,
} = Astro.props

// 从配置获取网站信息
const siteUrl = siteConfig.site.url || Astro.url.origin
const siteName = siteConfig.site.title

// 构建页面标题
const pageTitle = title && title !== siteName ? `${title} | ${siteName}` : siteName

// 构建规范 URL
const canonicalUrl = canonical ? new URL(canonical, siteUrl).href : Astro.url.href

// 构建完整的图片 URL
const ogImage = image ? new URL(image, siteUrl).href : undefined

// 构建 robots meta 内容
const robotsContent = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow'].join(', ')

// 构建结构化数据
let jsonLdType: 'WebSite' | 'Article' | 'BlogPosting' = 'WebSite'
let jsonLdData: Record<string, any>

if (type === 'article' && publishedTime) {
  jsonLdType = 'BlogPosting'
  jsonLdData = createBlogPostingSchema({
    title,
    description,
    url: canonicalUrl,
    image: ogImage,
    publishedTime,
    modifiedTime,
    author: {
      name: author,
      url: siteUrl,
    },
    publisher: {
      name: siteName,
      url: siteUrl,
    },
    tags,
  })
} else {
  jsonLdType = 'WebSite'
  jsonLdData = createWebSiteSchema({
    name: siteName,
    url: siteUrl,
    description: siteConfig.site.description,
    language: siteConfig.site.language,
  })
}
---

<!-- 基础 SEO Meta 标签 -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />

<!-- 规范 URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph 标签 -->
<OpenGraph
  title={pageTitle}
  description={description}
  image={image}
  url={canonicalUrl}
  type={type}
  siteName={siteName}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  tags={tags}
/>

<!-- Twitter Card 标签 -->
<TwitterCard title={pageTitle} description={description} image={image} />

<!-- JSON-LD 结构化数据 -->
<JsonLd type={jsonLdType} data={jsonLdData} />
