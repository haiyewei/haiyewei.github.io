---
/**
 * JsonLd 组件
 * 生成 JSON-LD 结构化数据，用于搜索引擎优化
 */

interface Props {
  /** Schema.org 类型 */
  type: 'WebSite' | 'Article' | 'BlogPosting' | 'Person' | 'Organization' | 'BreadcrumbList'
  /** 结构化数据内容 */
  data: Record<string, any>
}

const { type, data } = Astro.props

// 构建完整的 JSON-LD 对象
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type,
  ...data,
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
