---
/**
 * PostNavigation 组件
 * 文章翻页导航，支持上一篇/下一篇
 * 根据不同上下文（全部文章、分类、标签）显示不同的文章序列
 */
import { Icon } from 'astro-icon/components'

interface PostInfo {
  slug: string
  title: string
}

interface Props {
  /** 上一篇文章 */
  prevPost?: PostInfo
  /** 下一篇文章 */
  nextPost?: PostInfo
  /** 上下文类型 */
  context?: 'all' | 'category' | 'tag' | 'author'
  /** 上下文值（分类 slug、标签名或作者 slug） */
  contextValue?: string
}

const { prevPost, nextPost, context = 'all', contextValue } = Astro.props

/**
 * 根据上下文生成文章链接
 */
function getPostUrl(slug: string): string {
  const baseUrl = `/post/${slug}`
  if (context === 'all' || !contextValue) return baseUrl
  if (context === 'category')
    return `${baseUrl}?from=category&value=${encodeURIComponent(contextValue)}`
  if (context === 'tag') return `${baseUrl}?from=tag&value=${encodeURIComponent(contextValue)}`
  if (context === 'author')
    return `${baseUrl}?from=author&value=${encodeURIComponent(contextValue)}`
  return baseUrl
}

// 如果没有上一篇和下一篇，不渲染组件
const hasNavigation = prevPost || nextPost
---

{
  hasNavigation && (
    <nav class="post-navigation" aria-label="文章导航">
      <div class="post-navigation__container">
        {/* 上一篇 */}
        <div class="post-navigation__item post-navigation__item--prev">
          {prevPost ? (
            <a href={getPostUrl(prevPost.slug)} class="post-navigation__link">
              <span class="post-navigation__direction">
                <Icon name="material-symbols:arrow-back" class="post-navigation__icon" />
                <span>上一篇</span>
              </span>
              <span class="post-navigation__title">{prevPost.title}</span>
            </a>
          ) : (
            <div class="post-navigation__placeholder" aria-hidden="true" />
          )}
        </div>

        {/* 下一篇 */}
        <div class="post-navigation__item post-navigation__item--next">
          {nextPost ? (
            <a href={getPostUrl(nextPost.slug)} class="post-navigation__link">
              <span class="post-navigation__direction">
                <span>下一篇</span>
                <Icon name="material-symbols:arrow-forward" class="post-navigation__icon" />
              </span>
              <span class="post-navigation__title">{nextPost.title}</span>
            </a>
          ) : (
            <div class="post-navigation__placeholder" aria-hidden="true" />
          )}
        </div>
      </div>
    </nav>
  )
}

<style>
  .post-navigation {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--md-outline-variant);
  }

  .post-navigation__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .post-navigation__item {
    min-width: 0;
  }

  .post-navigation__item--prev {
    text-align: left;
  }

  .post-navigation__item--next {
    text-align: right;
  }

  .post-navigation__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--md-surface-container-low);
    border: 1px solid var(--md-outline-variant);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
    height: 100%;
  }

  .post-navigation__link:hover {
    background-color: var(--md-surface-container);
    border-color: var(--md-outline);
    box-shadow: var(--shadow-sm);
  }

  .post-navigation__item--next .post-navigation__link {
    align-items: flex-end;
  }

  .post-navigation__direction {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--md-on-surface-variant);
    font-weight: var(--font-medium);
  }

  .post-navigation__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .post-navigation__title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--md-on-surface);
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .post-navigation__link:hover .post-navigation__title {
    color: var(--md-primary);
  }

  .post-navigation__placeholder {
    display: none;
  }

  /* 响应式：移动端垂直堆叠 */
  @media (max-width: 640px) {
    .post-navigation__container {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .post-navigation__item--prev,
    .post-navigation__item--next {
      text-align: left;
    }

    .post-navigation__item--next .post-navigation__link {
      align-items: flex-start;
    }

    .post-navigation__item--next .post-navigation__direction {
      flex-direction: row-reverse;
    }

    .post-navigation__link {
      padding: var(--space-3);
    }

    .post-navigation__title {
      font-size: var(--text-sm);
    }
  }
</style>
