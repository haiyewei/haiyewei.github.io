---
/**
 * Footer 页脚组件
 * 多列布局设计，显示网站信息、社交链接和版权信息
 * 桌面端：3列布局 | 平板端：2列布局 | 移动端：单列布局
 */
import { Icon } from 'astro-icon/components'
import { siteConfig, getCopyright, getSocialLinks } from '../../utils/config'

interface Props {
  /** 自定义版权信息 */
  copyright?: string
  /** 是否显示社交链接 */
  showSocial?: boolean
}

const { copyright = getCopyright(), showSocial = true } = Astro.props

const footerLinks = siteConfig.footer.links
const socialLinks = getSocialLinks()

// 网站信息
const siteTitle = siteConfig.site.title
const siteDescription = siteConfig.site.description

// 社交链接图标映射（使用 Material Symbols 图标名称）
const socialIconNames: Record<string, string> = {
  github: 'mdi:github',
  twitter: 'mdi:twitter',
  email: 'material-symbols:mail',
}

// 社交链接显示名称
const socialDisplayNames: Record<string, string> = {
  github: 'GitHub',
  twitter: 'Twitter',
  email: '邮箱',
}

// 过滤有效的社交链接
const validSocialLinks = Object.entries(socialLinks).filter(
  ([key, value]) => value && socialIconNames[key]
)
---

<footer class="footer">
  <div class="footer-container">
    {/* 主内容区域 - 多列布局 */}
    <div class="footer-content">
      {/* 第一列：网站信息 + 关于链接 */}
      <div class="footer-column footer-brand">
        <h3 class="footer-title">{siteTitle}</h3>
        <p class="footer-description">{siteDescription}</p>
        <a href="/about" class="footer-about-link">关于</a>
      </div>

      {/* 第二列：社交链接 */}
      {
        showSocial && validSocialLinks.length > 0 && (
          <div class="footer-column">
            <h4 class="footer-column-title">社交</h4>
            <nav class="footer-social" aria-label="社交链接">
              {validSocialLinks.map(([key, value]) => (
                <a
                  href={key === 'email' ? `mailto:${value}` : value}
                  class="social-link"
                  target={key !== 'email' ? '_blank' : undefined}
                  rel={key !== 'email' ? 'noopener noreferrer' : undefined}
                  aria-label={socialDisplayNames[key]}
                >
                  <Icon name={socialIconNames[key]} size={18} aria-hidden="true" />
                  <span class="social-link-text">{socialDisplayNames[key]}</span>
                </a>
              ))}
            </nav>
          </div>
        )
      }

      {/* 第三列：其他链接 */}
      {
        footerLinks && footerLinks.length > 0 && (
          <div class="footer-column">
            <h4 class="footer-column-title">更多</h4>
            <nav class="footer-links" aria-label="其他链接">
              {footerLinks.map((link) => (
                <a href={link.href} class="footer-link">
                  {link.name}
                </a>
              ))}
            </nav>
          </div>
        )
      }
    </div>

    {/* 底部栏：分隔线 + 版权信息 */}
    <div class="footer-bottom">
      <div class="footer-divider"></div>
      <p class="footer-copyright">{copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background-color: var(--md-sys-color-surface-container, var(--md-surface-variant));
    padding: var(--space-12, 3rem) 0 var(--space-8, 2rem);
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal);
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* 多列布局 - 使用 CSS Grid */
  .footer-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8, 2rem);
  }

  /* 列样式 */
  .footer-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  /* 网站品牌列 */
  .footer-brand {
    grid-column: span 1;
  }

  .footer-title {
    margin: 0;
    font-size: var(--text-xl, 1.25rem);
    font-weight: var(--font-bold, 700);
    color: var(--md-sys-color-on-surface, var(--md-on-surface));
    line-height: 1.3;
  }

  .footer-description {
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-sys-color-on-surface-variant, var(--md-on-surface-variant));
    line-height: 1.6;
  }

  /* 关于链接 */
  .footer-about-link {
    margin-top: var(--space-2, 0.5rem);
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-sys-color-on-surface-variant, var(--md-on-surface-variant));
    text-decoration: none;
    transition: color var(--transition-fast);
    width: fit-content;
  }

  .footer-about-link:hover {
    color: var(--md-sys-color-primary, var(--md-primary));
  }

  /* 列标题 */
  .footer-column-title {
    margin: 0 0 var(--space-2, 0.5rem) 0;
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--font-semibold, 600);
    color: var(--md-sys-color-on-surface, var(--md-on-surface));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* 社交链接 */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-sys-color-on-surface-variant, var(--md-on-surface-variant));
    text-decoration: none;
    transition: color var(--transition-fast);
    width: fit-content;
  }

  .social-link:hover {
    color: var(--md-sys-color-primary, var(--md-primary));
  }

  .social-link-text {
    line-height: 1;
  }

  /* 其他链接 */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .footer-link {
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-sys-color-on-surface-variant, var(--md-on-surface-variant));
    text-decoration: none;
    transition: color var(--transition-fast);
    width: fit-content;
  }

  .footer-link:hover {
    color: var(--md-sys-color-primary, var(--md-primary));
  }

  /* 底部栏 */
  .footer-bottom {
    margin-top: var(--space-8, 2rem);
  }

  .footer-divider {
    height: 1px;
    background-color: var(--md-sys-color-outline-variant, var(--md-outline-variant));
    margin-bottom: var(--space-6, 1.5rem);
  }

  .footer-copyright {
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--md-sys-color-on-surface-variant, var(--md-on-surface-variant));
    text-align: center;
  }

  /* 平板端响应式 - 保持3列布局 */
  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6, 1.5rem) var(--space-8, 2rem);
    }
  }

  /* 小平板端响应式 - 2列布局 */
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6, 1.5rem) var(--space-8, 2rem);
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  /* 移动端响应式 - 单列布局 */
  @media (max-width: 640px) {
    .footer {
      padding: var(--space-8, 2rem) 0 var(--space-6, 1.5rem);
    }

    .footer-container {
      padding: 0 var(--space-4);
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--space-6, 1.5rem);
    }

    .footer-brand {
      grid-column: span 1;
      text-align: center;
    }

    .footer-column {
      align-items: center;
      text-align: center;
    }

    .footer-social,
    .footer-links {
      align-items: center;
    }

    .footer-about-link {
      margin: var(--space-2, 0.5rem) auto 0;
    }

    .footer-bottom {
      margin-top: var(--space-6, 1.5rem);
    }

    .footer-divider {
      margin-bottom: var(--space-4, 1rem);
    }
  }
</style>
