---
/**
 * Header 页头组件
 * 简化版：只包含 Logo、搜索按钮和主题切换按钮
 * 导航链接已移至页脚
 */
import ThemeToggle from '../interactive/ThemeToggle.astro'
import Search from '../interactive/Search.astro'
import { themeConfig } from '../../config/theme.config'
import { siteConfig, isFeatureEnabled } from '../../utils/config'

interface Props {
  /** 网站标题（可选，默认从配置读取） */
  siteTitle?: string
  /** 是否显示主题切换按钮 */
  showThemeToggle?: boolean
  /** 是否显示搜索框 */
  showSearch?: boolean
  /** 是否固定在顶部 */
  sticky?: boolean
}

const {
  siteTitle = siteConfig.site.title,
  showThemeToggle = isFeatureEnabled('darkMode') && themeConfig.appearance.themeToggle,
  showSearch = isFeatureEnabled('search'),
  sticky = true,
} = Astro.props
---

<header class:list={['header', { 'header-sticky': sticky }]}>
  <div class="header-container">
    <a href="/" class="header-logo">
      {siteTitle}
    </a>

    <div class="header-right">
      {/* 搜索按钮 */}
      {showSearch && <Search placeholder="搜索文章..." />}

      {/* 主题切换按钮 */}
      {showThemeToggle && <ThemeToggle initialTheme={themeConfig.appearance.defaultTheme} />}
    </div>
  </div>
</header>

<style>
  .header {
    background-color: var(--md-surface);
    box-shadow: var(--shadow-sm);
    height: var(--nav-height-mobile);
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .header-sticky {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    backdrop-filter: blur(8px);
    background-color: color-mix(in srgb, var(--md-surface) 90%, transparent);
  }

  .header-container {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--space-4);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header-logo {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--md-primary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    flex-shrink: 0;
  }

  .header-logo:hover {
    color: var(--md-primary);
    transform: scale(1.02);
    opacity: 0.8;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* 平板端 (640px - 1023px) */
  @media (min-width: 640px) {
    .header {
      height: var(--nav-height);
    }

    .header-container {
      padding: 0 var(--space-6);
    }

    .header-right {
      gap: var(--space-2);
    }
  }

  /* 桌面端 (≥ 1024px) */
  @media (min-width: 1024px) {
    .header-container {
      padding: 0 var(--space-8);
    }

    .header-right {
      gap: var(--space-2);
    }
  }

  /* 移动端/中屏下隐藏页头主题按钮，移至右下角悬浮按钮组 */
  @media (max-width: 1199px) {
    .header :global(.theme-toggle) {
      display: none;
    }
  }
</style>
