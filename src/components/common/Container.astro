---
/**
 * Container 容器组件
 * 提供响应式容器宽度，支持不同尺寸预设
 */

interface Props {
  /** 自定义 CSS 类名 */
  class?: string
  /** 容器尺寸预设 */
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
}

const { class: className = '', size = 'md' } = Astro.props

// 根据 size 获取对应的最大宽度
const sizeMap = {
  sm: 'var(--container-sm)',
  md: 'var(--container-md)',
  lg: 'var(--container-lg)',
  xl: 'var(--container-xl)',
  full: '100%',
}

const maxWidth = sizeMap[size]
---

<div class:list={['container', className]} style={`--container-max-width: ${maxWidth}`}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max-width, var(--container-md));
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
  }

  @media (min-width: 640px) {
    .container {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }
  }
</style>
